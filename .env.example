# ---------------------------------------------------------------------------
# Aviator AI Lab — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase (leave blank to use the local JSON dev store in ./.data — dev only)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: safe for the browser, only used for read-only Realtime subscriptions (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Python ML service (deployed separately)
ML_SERVICE_URL=http://localhost:8000
# Shared secret; must match ML_SERVICE_TOKEN on the ML service
ML_SERVICE_TOKEN=

# Admin access for write operations (imports, deletes, training).
# Required in production; in development writes are allowed when unset.
ADMIN_PASSWORD=
# Random 32+ char string used to sign admin session cookies
SESSION_SECRET=

# Bearer key for the authorised live-ingestion endpoint POST /api/ingest
INGEST_API_KEY=

# Generate a fresh next-round estimate automatically after new real rounds arrive
AUTO_PREDICT=true
